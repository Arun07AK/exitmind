{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "redesign-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch-path=src", "--watch-path=config", "--watch-path=data/design", "src/server/index.ts"],
      "env": { "PORT": "8091", "EXITMIND_OFFLINE": "1" },
      "port": 8091
    },
    {
      "name": "redesign-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5174", "--strictPort"],
      "env": { "EXITMIND_API": "http://localhost:8091" },
      "port": 5174
    }
  ]
}
