# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# Persona backend: jev | haiku | none. No default on purpose (blueprint O3).
PERSONA_BACKEND=
PERSONA_HAIKU_MODEL=claude-haiku-5-5
JEV_MODEL=jev-1.14.0
PLANNER_MODEL=claude-sonnet-5-5
LIAISON_MODEL=claude-haiku-5-5
# 1 = never call any LLM; all fallbacks are used.
EXITMIND_OFFLINE=0
PORT=8080
